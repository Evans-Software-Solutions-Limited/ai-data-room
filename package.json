{
  "name": "ai-data-room",
  "version": "1.0.0",
  "description": "AI-native secure data room. SST v4 monorepo. See /briefs and /specs in the project workspace for product context, /adr for architecture decisions.",
  "private": true,
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "packages/*",
    "microservices/*"
  ],
  "scripts": {
    "dev": "sst dev",
    "prettier:check": "prettier --check .",
    "prettier:write": "prettier --write .",
    "typecheck": "bun run typecheck:infra && turbo run typecheck --cache-dir .turbo",
    "typecheck:infra": "tsc -p tsconfig.infra.json",
    "lint": "turbo run lint --cache-dir .turbo",
    "build": "turbo run build --cache-dir .turbo",
    "test": "turbo run test:unit --cache-dir .turbo",
    "test:unit": "turbo run test:unit --cache-dir .turbo",
    "db:generate": "bun run --filter @ai-data-room/db generate",
    "db:migrate": "bun run --filter @ai-data-room/db migrate",
    "db:studio": "bun run --filter @ai-data-room/db studio",
    "db:check": "bash scripts/db-drift-check.sh",
    "db:test:integration": "bun run --filter @ai-data-room/db test:integration",
    "core:test:integration": "bun run --filter @ai-data-room/core test:integration",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "tear-down": "sst remove"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@tsconfig/node22": "^22",
    "dotenv": "^17.4.2",
    "prettier": "3.8.1",
    "turbo": "^2.3.3",
    "typescript": "^5"
  },
  "dependencies": {
    "sst": "^4"
  }
}
